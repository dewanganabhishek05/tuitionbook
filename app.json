{
  "expo": {
    "name": "TuitionBook",
    "slug": "tuitionbook",
    "version": "1.5.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tuitionbook.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tuitionbook.app",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "versionCode": 9
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "TuitionBook uses the camera to take a photo of a student list.",
          "microphonePermission": false,
          "photosPermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#FFFFFF",
          "resizeMode": "contain"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.REPLACE_WITH_IOS_CLIENT_ID"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true
          }
        }
      ],
      "./plugins/withAndroidRelease"
    ],
    "scheme": "tuitionbook",
    "extra": {
      "googleWebClientId": "701250915154-93p30pfco0iocdipqml5tpgm661pc9dt.apps.googleusercontent.com",
      "googleSetup": {
        "package": "com.tuitionbook.app",
        "sha1": "D1:D8:B0:64:DC:8C:D3:AB:3E:56:E8:9C:78:48:1E:4C:71:75:30:B1"
      }
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
